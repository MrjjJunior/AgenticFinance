MAIN_ACCOUNT_ADDRESS=rYOUR_MAIN_POOL_ACCOUNT_ADDRESS_HERE

# RLUSD (Testnet)
RLUSD_CURRENCY_HEX=524C555344000000000000000000000000000000
RLUSD_ISSUER=rQhWct2fv4Vc4KRjRgMrxa8xPN9Zx9iLKV

# ------ Signer Seeds ----------------------------------------
# SECURITY: These are the AGENT and COSIGNER own wallet seeds.
#           NOT the main account seed. The main account master key is DISABLED.
