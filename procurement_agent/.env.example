# ---------------------------------------------------------------------------
# Stokvel AI Procurement Agent – environment configuration
#
# Copy this file to `.env` and fill in real values before running:
#   Copy-Item .env.example .env
#
# TIP: Run  python setup_wallets.py  to generate funded Testnet wallets and
#      write a ready-to-use .env automatically.
#
# NEVER commit a real .env to version control.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# XRPL Network (Testnet)
# ---------------------------------------------------------------------------
XRPL_NODE_URL=https://s.altnet.rippletest.net:51234/

# The Stokvel pool account whose master key is DISABLED.
# All transactions originate from this address (must have a 2-of-2 signer list).
MAIN_ACCOUNT_ADDRESS=rMAIN_ACCOUNT_ADDRESS_PLACEHOLDER

# ---------------------------------------------------------------------------
# RLUSD Token Config (Testnet) – keep the defaults for Testnet
# ---------------------------------------------------------------------------
RLUSD_CURRENCY_HEX=524C555344000000000000000000000000000000
RLUSD_ISSUER=rQhWct2fv4Vc4KRjRgMrxa8xPN9Zx9iLKV

# ---------------------------------------------------------------------------
# Wallet identities – REAL seeds look like "sEd7..." or "s..." (base58).
#   They never contain the characters 0, O, I or l.
#   Agent + cosigner are weight-1 signers on the main account; each uses
#   its OWN seed. The cosigner seed is ONLY read by the cosigner service.
# ---------------------------------------------------------------------------
AGENT_SEED=sAGENT_SEED_PLACEHOLDER
POLICY_COSIGNER_SEED=sCOSIGNER_SEED_PLACEHOLDER

# Policy Co-Signer service (the INDEPENDENT limits service)
# Run from the repo root:
#   python -m uvicorn cosigner_service.main:create_app --factory --port 8001
POLICY_COSIGNER_BASE_URL=http://localhost:8001
# Optional token that protects the cosigner's admin endpoints:
# COSIGNER_ADMIN_TOKEN=change-me

# ---------------------------------------------------------------------------
# LLM Configuration
# NOTE: AI verification is REAL and fail-closed: a missing/invalid key
#       ABORTS the workflow instead of skipping the check.
# ---------------------------------------------------------------------------
OPENAI_API_KEY=sk-PLACEHOLDER
LLM_MODEL=gpt-4o-mini
# Optional: point at an OpenAI-compatible stub for offline testing
# OPENAI_BASE_URL=http://localhost:18099/v1

# ---------------------------------------------------------------------------
# Mandate / Business Rules (SEED VALUES ONLY)
# The cosigner service copies these into cosigner_limits.json on its FIRST
# run; after that the Human Owner changes them via the Owner Console /
# POST /admin/limits — outside the agent.
# ---------------------------------------------------------------------------
# Daily spending cap per member in RLUSD
DAILY_SPENDING_CAP_RLUSD=5000.00

# ---------------------------------------------------------------------------
# KYB / Allowlist (XLS-70)
# Comma-separated XRPL addresses of KYB-approved suppliers.
# Suppliers NOT on this list are REJECTED at Step 2.
# ---------------------------------------------------------------------------
APPROVED_SUPPLIER_ADDRESSES=rSupplierAlpha000000000000000000,rSupplierBeta0000000000000000000
# The Credential type to look for on-ledger
KYB_CREDENTIAL_TYPE=KYBVerified
